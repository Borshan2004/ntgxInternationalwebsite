# ============================================================
# FedEx Enterprise Replica — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ============================================================

# ------------------------------------------------------------------
# Neon Serverless PostgreSQL (https://neon.tech)
# Use the pooled connection string for runtime queries (PgBouncer).
# Use the direct (non-pooled) string for Prisma migrations only.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/fedex_replica?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/fedex_replica?sslmode=require"

# ------------------------------------------------------------------
# App URL — used to build tracking links in emails & PDFs
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Resend Transactional Email (https://resend.com)
# Leave blank to fall back to console.log in development.
# ------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="logistics@yourdomain.com"

# ------------------------------------------------------------------
# FedEx API Credentials (optional — for live FedEx Track API proxy)
# ------------------------------------------------------------------
FEDEX_CLIENT_ID=""
FEDEX_CLIENT_SECRET=""
FEDEX_API_BASE_URL="https://apis.fedex.com"

# ------------------------------------------------------------------
# Auth (if adding NextAuth.js later)
# ------------------------------------------------------------------
# NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# NEXTAUTH_URL="http://localhost:3000"
