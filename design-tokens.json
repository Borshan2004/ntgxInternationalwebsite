{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "systemName": "NTGX Express & Freight Enterprise Design System",
    "version": "3.0.0"
  },
  "colors": {
    "brand": {
      "red": "#E51919",
      "redHover": "#C81212",
      "redActive": "#9B0E0E",
      "redSubtle": "#FEF2F2",
      "dark": "#18181B",
      "darkHover": "#27272A",
      "gray": "#4B5563",
      "purple": "#E51919",
      "purpleHover": "#C81212",
      "purpleActive": "#9B0E0E",
      "purpleSubtle": "#FEF2F2",
      "orange": "#E51919",
      "orangeHover": "#C81212",
      "orangeSubtle": "#FEF2F2",
      "accentBlue": "#007AB7",
      "accentBlueHover": "#005F8F"
    },
    "status": {
      "draft": {
        "bg": "#F3F4F6",
        "text": "#374151",
        "border": "#D1D5DB",
        "dot": "#6B7280"
      },
      "printed": {
        "bg": "#EFF6FF",
        "text": "#1D4ED8",
        "border": "#BFDBFE",
        "dot": "#2563EB"
      },
      "pickupScheduled": {
        "bg": "#F0FDF4",
        "text": "#15803D",
        "border": "#BBF7D0",
        "dot": "#16A34A"
      },
      "inTransit": {
        "bg": "#FFFBEB",
        "text": "#B45309",
        "border": "#FDE68A",
        "dot": "#D97706"
      },
      "outForDelivery": {
        "bg": "#F5F3FF",
        "text": "#6D28D9",
        "border": "#DDD6FE",
        "dot": "#7C3AED"
      },
      "delivered": {
        "bg": "#ECFDF5",
        "text": "#047857",
        "border": "#A7F3D0",
        "dot": "#059669"
      },
      "exception": {
        "bg": "#FEF2F2",
        "text": "#B91C1C",
        "border": "#FECACA",
        "dot": "#DC2626"
      }
    },
    "neutral": {
      "canvas": "#F4F5F7",
      "surface": "#FFFFFF",
      "surfaceMuted": "#F8FAFC",
      "border": "#E2E8F0",
      "borderFocus": "#E51919",
      "textPrimary": "#0F172A",
      "textSecondary": "#64748B",
      "textMuted": "#94A3B8",
      "awbInk": "#111827"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "fontSize": {
      "2xs": "0.6875rem",
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "shadows": {
    "xs": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "sm": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
    "card": "0 2px 4px 0 rgba(0, 0, 0, 0.06), 0 1px 2px 0 rgba(0, 0, 0, 0.04)"
  },
  "radii": {
    "none": "0px",
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "full": "9999px"
  }
}
