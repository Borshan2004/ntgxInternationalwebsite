# ==============================================================================
# FedEx Enterprise Replica — Production Environment Configuration (.env.example)
# Copy this file to .env.local for local development, or set in Vercel Dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL (https://neon.tech)
# ------------------------------------------------------------------------------
# Pooled connection string with PgBouncer enabled for serverless API routes.
DATABASE_URL="postgresql://neondb_owner:<your_password>@ep-mute-base-bcqkn5ry-pooler.c-16.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Unpooled direct connection string for Prisma migrations (prisma migrate deploy).
DIRECT_URL="postgresql://neondb_owner:<your_password>@ep-mute-base-bcqkn5ry.c-16.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 2. Application Domain & Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-fedex-replica.vercel.app"
NEXTAUTH_URL="https://your-fedex-replica.vercel.app"
NEXTAUTH_SECRET="generate-via-openssl-rand-base64-32-chars-minimum"

# ------------------------------------------------------------------------------
# 3. Enterprise n8n Workflow Webhooks
# ------------------------------------------------------------------------------
# Endpoint for n8n Webhook node triggering multi-channel notifications
N8N_LOGISTICS_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/fedex-logistics-events"

# Cryptographic HMAC-SHA256 secret shared between Next.js and n8n Webhook node
N8N_WEBHOOK_HMAC_SECRET="production-fedex-enterprise-hmac-sha256-secret-key"

# ------------------------------------------------------------------------------
# 4. Resend Transactional Email (https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="logistics@yourcompany.com"
